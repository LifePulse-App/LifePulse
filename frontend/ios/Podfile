require 'json'
require 'pathname'
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, '16.0'

# 🔥 Enable New Architecture
ENV['RCT_NEW_ARCH_ENABLED'] = '1'

prepare_react_native_project!

target 'StreakSphere' do
  config = use_native_modules!

  pod 'NitroModules', :path => '../node_modules/react-native-nitro-modules'
  pod 'CodePush', :path => '../node_modules/@revopush/react-native-code-push'

  # Firebase modular headers
  pod 'GoogleUtilities', :modular_headers => true
  pod 'FirebaseCoreInternal', :modular_headers => true
  pod 'FirebaseCore', :modular_headers => true
  pod 'FirebaseCoreExtension', :modular_headers => true
  pod 'FirebaseInstallations', :modular_headers => true
  pod 'FirebaseMessaging', :modular_headers => true
  pod 'GoogleDataTransport', :modular_headers => true
  pod 'nanopb', :modular_headers => true
  pod 'RecaptchaInterop', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => true,
    :new_arch_enabled => true,
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    
    # 🧹 PERMANENT MAPLIBRE FIX: Nuke signatures directly from the hard drive
    # This completely bypasses Xcode, ensuring zero project corruption 
    # while preventing the "Multiple commands produce" error in Release builds.
    puts "🧹 Cleaning MapLibre signatures from disk..."
    require 'fileutils'
    Dir.glob("#{installer.sandbox.root}/**/MapLibre*.signature").each do |file|
      FileUtils.rm_rf(file)
    end
    Dir.glob("#{installer.sandbox.root}/**/MapLibre*/_CodeSignature").each do |dir|
      FileUtils.rm_rf(dir)
    end

    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    $MLRN.post_install(installer) if defined?($MLRN)

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        if `uname -m`.strip == "x86_64"
          build_config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'arm64'
        end
        build_config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'NO'
      end

      # 🪄 FIX: CodePush / RevoPush Core Headers
      if target.name == 'CodePush' || target.name == 'react-native-code-push' || target.name == 'revopush-react-native-code-push'
        target.build_configurations.each do |config|
          config.build_settings['DEFINES_MODULE'] = 'YES'
          config.build_settings['HEADER_SEARCH_PATHS'] ||= ['$(inherited)']
          config.build_settings['HEADER_SEARCH_PATHS'] << '"${PODS_ROOT}/Headers/Public/React-Core"'
        end
      end

      # 🪄 FIX: MapLibre Basic Settings (NO script injection)
      if target.name == 'maplibre-react-native' || target.name.include?('MapLibre')
        target.build_configurations.each do |config|
          config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'NO'
          config.build_settings['SKIP_INSTALL'] = 'NO'
        end
      end
    end
  end
end